#!/bin/bash
# SPDX-License-Identifier: MIT
#
# lota-steam-setup -- Configure Steam for LOTA integration
#
# Checks that the LOTA agent and the hook library are in place for
# Steam Runtime pressure-vessel containers (soldier, sniper, etc.),
# creates $XDG_RUNTIME_DIR/lota/ and prints the Steam launch options.
#
# Usage:
#   lota-steam-setup             Run setup checks
#   lota-steam-setup --verify    Verify existing setup only
#   lota-steam-setup --help      Show help
#
# Copyright (C) 2026 Szymon Wilczek

set -euo pipefail

LOTA_GROUP="lota"
SOCKET_NAME="lota.sock"
PRIMARY_SOCKET="${LOTA_AGENT_SOCKET:-/run/lota/${SOCKET_NAME}}"
HOOK_LIB="liblota_wine_hook.so"
# Mirrors LOTA_HOOK_TOKEN_DIR_NAME in include/lota_wine_hook.h
HOOK_TOKEN_DIR_NAME="lota-hook"
LOTA_CONF="${LOTA_CONF:-/etc/lota/lota.conf}"

if [[ -t 1 ]]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    BLUE='\033[0;34m'
    NC='\033[0m'
else
    RED='' GREEN='' YELLOW='' BLUE='' NC=''
fi

info() { echo -e "${BLUE}[INFO]${NC} $*"; }
ok() { echo -e "${GREEN}[OK]${NC}   $*"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
fail() { echo -e "${RED}[FAIL]${NC} $*"; }

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Configure Steam Runtime integration for LOTA.

Options:
  --verify                    Only check existing setup, do not
                              modify anything
  --install-systemd-dropin    Install the systemd drop-in that pins
                              XDG_RUNTIME_DIR=/run/user/<uid> for
                              lota-agent.service, so the agent's
                              container-aware secondary listener
                              (\$XDG_RUNTIME_DIR/lota/lota.sock)
                              comes up under the operator's
                              runtime dir on boot. The agent reads it
                              at startup, so it takes effect at the
                              next boot; nothing here stops the
                              running agent. Requires root.
                              Single-operator hosts only; for
                              multiple operators use --register-uid.
  --register-uid              Write container_listener_uid = \$SUDO_UID
                              into ${LOTA_CONF} so every configured
                              UID gets its own
                              /run/user/<uid>/lota/lota.sock listener
                              when that user logs in. The agent reads
                              the setting at startup, so it takes
                              effect at the next boot. Supersedes the
                              drop-in on multi-user hosts. Requires
                              root.
  --help                      Show this help message

Environment:
  XDG_RUNTIME_DIR   Base directory for user runtime files. A login
                    session sets it; an account without one has no
                    container socket and no token directory, which
                    the checks that read it report as such.
  LOTA_AGENT_SOCKET The agent's socket to check (default
                    /run/lota/lota.sock).
  LOTA_SETUP_DROPIN_DIR
                    Directory for the --install-systemd-dropin file
                    (default /etc/systemd/system). For
                    package staging and tests: no systemd on this host
                    is configured, so root is not required either.
EOF
}

check_xdg_runtime_dir() {
    if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
        fail "XDG_RUNTIME_DIR is not set"
        echo "  This variable is required for container-aware IPC."
        echo "  It is normally set by systemd-logind or elogind."
        return 1
    fi

    if [[ ! -d "$XDG_RUNTIME_DIR" ]]; then
        fail "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR does not exist"
        return 1
    fi

    ok "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"
    return 0
}

check_agent_running() {
    if [[ -S "$PRIMARY_SOCKET" ]]; then
        if [[ -r "$PRIMARY_SOCKET" && -w "$PRIMARY_SOCKET" ]]; then
            ok "LOTA agent socket: $PRIMARY_SOCKET"
            return 0
        fi

        warn "LOTA agent socket exists but this account cannot open it: $PRIMARY_SOCKET"
        echo "  It is handed to the '$LOTA_GROUP' group:"
        ls -l "$PRIMARY_SOCKET" 2>/dev/null | sed 's/^/    /'
        echo "  Check that this user is in the '$LOTA_GROUP' group."
        return 1
    fi

    warn "LOTA agent socket not found at $PRIMARY_SOCKET"
    echo "  The agent is not running.  It runs under systemd, so do not"
    echo "  start it by hand; the installer finds out why and says what"
    echo "  brings it back (after a pause, that is a reboot):"
    echo "    sudo lota-install"
    return 1
}

check_lota_group() {
    if getent group "$LOTA_GROUP" >/dev/null 2>&1; then
        ok "Group '$LOTA_GROUP' exists"
    else
        warn "Group '$LOTA_GROUP' does not exist"
        echo "  Create it with: sudo groupadd $LOTA_GROUP"
        echo "  Add your user:  sudo usermod -aG $LOTA_GROUP \$USER"
        return 1
    fi

    if id -nG | grep -qw "$LOTA_GROUP"; then
        ok "Current user is a member of group '$LOTA_GROUP'"
    else
        warn "Current user is not a member of '$LOTA_GROUP'"
        echo "  Add with: sudo usermod -aG $LOTA_GROUP $(whoami)"
        echo "  Then log out and back in."
        return 1
    fi

    return 0
}

check_hook_library() {
    local found="" found32=""

    for dir in /usr/lib64 /usr/local/lib64; do
        for candidate in "$dir/${HOOK_LIB}" "$dir"/${HOOK_LIB}.[0-9]*; do
            if [[ -f "$candidate" ]]; then
                found="$candidate"
                break 2
            fi
        done
    done

    for dir in /usr/lib /usr/local/lib; do
        for candidate in "$dir/${HOOK_LIB}" "$dir"/${HOOK_LIB}.[0-9]*; do
            if [[ -f "$candidate" ]]; then
                found32="$candidate"
                break 2
            fi
        done
    done

    if [[ -z "$found" && -z "$found32" ]]; then
        warn "Hook library ($HOOK_LIB) not found in standard paths"
        echo "  It ships in lota-sdk, which lota-agent pulls in."
        return
    fi

    if [[ -n "$found" && -n "$found32" ]]; then
        ok "Hook library found, both kinds: $found and $found32"
        return
    fi

    ok "Hook library found: ${found:-$found32}"
    warn "Only one kind of it is installed, so Steam will log a complaint"
    echo "  Steam starts a game through several small programs of its own,"
    echo "  and not all of them are the same kind of program. Each is handed"
    echo "  the same LOTA library to load, and the ones that cannot read this"
    echo "  copy say so in the log. The game still runs and LOTA still works."
    echo "  Installing the missing copy stops the message:"
    echo "    sudo dnf install lota-sdk"
    echo "  If that is already installed, the package was built without its"
    echo "  32-bit half; a build from source needs glibc-devel.i686 and"
    echo "  libatomic.i686."
}

no_session_runtime_dir() {
    warn "$1: this account has no session runtime directory"
    echo "  XDG_RUNTIME_DIR is unset, so there is no /run/user/<uid> to use."
    echo "  Run this from the account that starts Steam, in its own login"
    echo "  session."
    return 1
}

setup_container_socket_dir() {
    local dir

    if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
        no_session_runtime_dir "Cannot create the container socket directory"
        return 1
    fi

    dir="${XDG_RUNTIME_DIR}/lota"

    if [[ -d "$dir" ]]; then
        ok "Container socket directory exists: $dir"
        return 0
    fi

    info "Creating container socket directory: $dir"
    mkdir -p "$dir"
    chmod 0750 "$dir"

    if getent group "$LOTA_GROUP" >/dev/null 2>&1; then
        chgrp "$LOTA_GROUP" "$dir" 2>/dev/null || true
    fi

    ok "Created: $dir"
}

check_container_socket() {
    local container_socket

    if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
        no_session_runtime_dir "No container socket to check"
        return 1
    fi

    container_socket="${XDG_RUNTIME_DIR}/lota/${SOCKET_NAME}"

    # a directory this user cannot enter hides the socket: it may not be missing
    if [[ -d "${container_socket%/*}" && ! -x "${container_socket%/*}" ]]; then
        warn "Cannot look inside ${container_socket%/*}, so the container socket cannot be checked"
        echo "  It is handed to the '$LOTA_GROUP' group:"
        ls -ld "${container_socket%/*}" 2>/dev/null | sed 's/^/    /'
        echo "  Check that this user is in the '$LOTA_GROUP' group, then log"
        echo "  out and back in."
        return 1
    fi

    if [[ -S "$container_socket" ]]; then
        if [[ -r "$container_socket" && -w "$container_socket" ]]; then
            ok "Container socket: $container_socket"
            return 0
        fi

        warn "Container socket exists but this user cannot open it: $container_socket"
        echo "  It should be owned by group '$LOTA_GROUP' and mode 0660:"
        ls -l "$container_socket" 2>/dev/null | sed 's/^/    /'
        echo "  Check that this user is in the '$LOTA_GROUP' group, then"
        echo "  report the agent's own message: journalctl -u lota-agent | grep chown"
        return 1
    fi

    warn "Container socket not found: $container_socket"
    echo "  The agent creates it when the configured user logs in, so it"
    echo "  exists only for a UID the agent was told about:"
    echo "    sudo lota-steam-setup --register-uid   # writes container_listener_uid"
    echo "  That setting is read at agent startup, so a host that has not"
    echo "  rebooted since it was written has no listener yet. Do not restart"
    echo "  the agent to get one: stopping it spends this boot's PCR 14"
    echo "  commitment and the host cannot attest again until it reboots."
    return 1
}

check_hook_token_dir() {
    local dir

    if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
        no_session_runtime_dir "No hook token directory to check"
        return 1
    fi

    dir="${XDG_RUNTIME_DIR}/${HOOK_TOKEN_DIR_NAME}"

    if [[ ! -e "$dir" ]]; then
        ok "Hook token directory will be created at first launch: $dir"
        return 0
    fi

    if [[ ! -d "$dir" ]]; then
        warn "Hook token directory path is not a directory: $dir"
        echo "  The hook falls back to /tmp/lota-$(id -u), so attestation"
        echo "  still works, but remove this to keep the artifacts in the"
        echo "  runtime directory."
        return 1
    fi

    if [[ ! -O "$dir" ]]; then
        warn "Hook token directory is not owned by this user: $dir"
        ls -ld "$dir" 2>/dev/null | sed 's/^/    /'
        echo "  The hook refuses a directory somebody else owns and falls"
        echo "  back to /tmp/lota-$(id -u). Remove it to use the runtime"
        echo "  directory again."
        return 1
    fi

    ok "Hook token directory: $dir"
    return 0
}

verify_only=false
install_dropin=false
register_uid=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --verify)
            verify_only=true
            shift
            ;;
        --install-systemd-dropin)
            install_dropin=true
            shift
            ;;
        --register-uid)
            register_uid=true
            shift
            ;;
        --help | -h)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

install_systemd_dropin() {
    local uid dropin_dir dropin redirected=false

    dropin_dir="/etc/systemd/system/lota-agent.service.d"
    if [[ -n "${LOTA_SETUP_DROPIN_DIR:-}" ]]; then
        dropin_dir="$LOTA_SETUP_DROPIN_DIR"
        redirected=true
    fi

    if ! $redirected && [[ $EUID -ne 0 ]]; then
        fail "--install-systemd-dropin must run as root (try: sudo $(basename "$0") --install-systemd-dropin)"
        return 1
    fi
    # $SUDO_UID, so the drop-in does not pin XDG_RUNTIME_DIR to /run/user/0
    if [[ -z "${SUDO_UID:-}" ]]; then
        fail "could not determine the operator UID"
        fail "invoke as: sudo $(basename "$0") --install-systemd-dropin"
        fail "(direct 'su -' / login as root strips \$SUDO_UID and is not supported)"
        return 1
    fi

    uid="$SUDO_UID"
    case "$uid" in
        '' | *[!0-9]*)
            fail "SUDO_UID=${SUDO_UID} is not a positive integer"
            return 1
            ;;
    esac
    if [[ "$uid" -eq 0 ]]; then
        fail "SUDO_UID=0; rerun from a non-root login shell"
        return 1
    fi

    dropin="${dropin_dir}/10-xdg-runtime.conf"

    info "This takes effect at the next boot. The running agent keeps"
    info "serving titles unchanged until then, and nothing here stops it."

    info "Installing drop-in: ${dropin}"
    mkdir -p "$dropin_dir"
    cat >"$dropin" <<EOF
# SPDX-License-Identifier: MIT
# Generated by lota-steam-setup --install-systemd-dropin.
# See systemd/lota-agent.service.d/10-xdg-runtime.conf.example
# in the source tree for the rationale.

[Service]
Environment=XDG_RUNTIME_DIR=/run/user/${uid}
EOF
    chmod 0644 "$dropin"

    $redirected || systemctl daemon-reload
    ok "drop-in installed for uid=${uid}; reboot to create the listener"
}

if $install_dropin; then
    install_systemd_dropin || exit 1
    echo ""
    echo "Reboot, then from the operator account run:"
    echo "  lota-steam-setup --verify"
    echo "to confirm the new /run/user/${SUDO_UID}/lota/lota.sock listener,"
    echo "then paste the printed Steam launch options into the game's"
    echo "Properties -> General -> Launch options field."
    exit 0
fi

register_container_listener_uid() {
    local uid line backup created=false

    if [[ $EUID -ne 0 ]]; then
        fail "--register-uid must run as root (try: sudo $(basename "$0") --register-uid)"
        return 1
    fi
    if [[ -z "${SUDO_UID:-}" ]]; then
        fail "could not determine the operator UID"
        fail "invoke as: sudo $(basename "$0") --register-uid"
        fail "(direct 'su -' / login as root strips \$SUDO_UID and is not supported)"
        return 1
    fi

    uid="$SUDO_UID"
    case "$uid" in
        '' | *[!0-9]*)
            fail "SUDO_UID=${SUDO_UID} is not a positive integer"
            return 1
            ;;
    esac
    if [[ "$uid" -eq 0 ]]; then
        fail "SUDO_UID=0; rerun from a non-root login shell"
        return 1
    fi

    # The package ships the directory, not the file.
    if [[ ! -d "$(dirname -- "$LOTA_CONF")" ]]; then
        fail "$(dirname -- "$LOTA_CONF") does not exist; install LOTA before --register-uid"
        return 1
    fi
    if [[ ! -e "$LOTA_CONF" ]]; then
        created=true
        (umask 022 && : >"$LOTA_CONF")
    fi

    line="container_listener_uid = ${uid}"
    if grep -Eq "^[[:space:]]*container_listener_uid[[:space:]]*=[[:space:]]*${uid}[[:space:]]*$" "$LOTA_CONF"; then
        ok "uid=${uid} already registered in ${LOTA_CONF}"
        return 0
    fi

    info "This takes effect at the next boot. The running agent keeps"
    info "serving titles unchanged until then, and nothing here stops it."

    backup="${LOTA_CONF}.lota-steam-setup.bak"
    cp -p -- "$LOTA_CONF" "$backup"

    # container_listener_uid is a top-level key: a key after a [profile "..."]
    # header belongs to that profile, and a top-level key there stops the file
    # parsing.
    info "Writing '${line}' to ${LOTA_CONF}"
    if grep -Eq '^[[:space:]]*\[profile' "$LOTA_CONF"; then
        awk -v line="$line" '
            !done && /^[[:space:]]*\[profile/ {
                print "# Added by lota-steam-setup --register-uid"
                print line
                print ""
                done = 1
            }
            { print }
        ' "$backup" >"$LOTA_CONF"
    else
        printf '\n# Added by lota-steam-setup --register-uid\n%s\n' \
               "$line" >>"$LOTA_CONF"
    fi

    if ! lota-agent --dump-config --config "$LOTA_CONF" >/dev/null 2>&1; then
        if $created; then
            rm -f -- "$LOTA_CONF" "$backup"
        else
            cp -p -- "$backup" "$LOTA_CONF"
        fi
        fail "the resulting ${LOTA_CONF} does not parse; restored the original"
        fail "nothing was changed. Report this with the config layout"
        return 1
    fi

    rm -f -- "$backup"
    ok "uid=${uid} registered in ${LOTA_CONF}; reboot to create the listener"
}

if $register_uid; then
    register_container_listener_uid || exit 1
    echo ""
    echo "Reboot, then from the operator account run:"
    echo "  lota-steam-setup --verify"
    echo "to confirm /run/user/${SUDO_UID}/lota/lota.sock is live,"
    echo "then paste the printed Steam launch options into the game's"
    echo "Properties -> General -> Launch options field."
    echo ""
    echo "The setting is read when the agent starts, so it does not take"
    echo "effect before that reboot; the socket itself is created when the"
    echo "registered user logs in, and again after every logout."
    exit 0
fi

echo "=== LOTA Steam Runtime Integration Setup ==="
echo ""

errors=0

check_xdg_runtime_dir || errors=$((errors + 1))
check_agent_running || errors=$((errors + 1))
check_lota_group || errors=$((errors + 1))
check_hook_library

echo ""

if ! $verify_only; then
    info "Setting up container-accessible socket directory..."
    setup_container_socket_dir || errors=$((errors + 1))
fi

check_container_socket || errors=$((errors + 1))
check_hook_token_dir || errors=$((errors + 1))

echo ""
echo "=== Steam Launch Options ==="
echo ""
echo "  For games launched through Steam's pressure-vessel container"
echo "  (any Proton title and most native Linux titles on Steam),"
echo "  the LOTA socket must be bind-mounted into the container, and"
echo "  so must the directory the hook writes its status and token"
echo "  into -- otherwise those files land inside the container and"
echo "  nothing on this machine can read them.  The wrapper asks for"
echo "  both itself, so the line to paste into the game's Properties"
echo "  -> General -> Launch options is this one:"
echo ""
runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
    warn "No session here, so the paths below are this account's own."
    echo "  Run this from the account that starts Steam for the string"
    echo "  to paste."
    echo ""
fi
echo "    LOTA_HOOK_LOG_LEVEL=info lota-proton-hook %command%"
echo ""
echo "  The wrapper binds ${runtime_dir}/lota (the socket) and"
echo "  ${runtime_dir}/${HOOK_TOKEN_DIR_NAME} (its own output)"
echo "  into the container, and creates the second one first, so"
echo "  neither path has to be named here.  A title needing a socket"
echo "  somewhere else takes LOTA_HOOK_SOCKET, and the wrapper then"
echo "  binds the directory that socket is in."
echo ""
echo "  For a host-side launch outside the pressure-vessel"
echo "  container (a native binary you run directly):"
echo ""
echo "    LOTA_HOOK_LOG_LEVEL=info LD_PRELOAD=${HOOK_LIB} %command%"
echo ""
echo "  Either way the hook writes lota-status, lota-token.bin and"
echo "  lota-attestation.bin into ${runtime_dir}/${HOOK_TOKEN_DIR_NAME}/,"
echo "  which is where a launcher or an anti-cheat SDK reads them from."
echo ""

if [[ $errors -gt 0 ]]; then
    echo ""
    warn "$errors issue(s) detected.  See warnings above."
    exit 1
fi

ok "All checks passed.  LOTA Steam integration is ready."
