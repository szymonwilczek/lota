#!/bin/bash
# SPDX-License-Identifier: MIT
#
# lota-proton-hook -- Launch wrapper for Steam/Proton with LOTA integration
#
# Sets LD_PRELOAD so that the LOTA Wine hook library is loaded into
# the Wine/Proton process, transparently bridging attestation into
# the Windows game, and shares the agent's socket directory and the hook's
# token directory through PRESSURE_VESSEL_FILESYSTEMS_RW.
#
# Usage:
#   As Steam launch option:
#     lota-proton-hook %command%
#
#   Direct:
#     lota-proton-hook wine game.exe
#     lota-proton-hook proton run game.exe
#
# Environment:
#   LOTA_HOOK_LIB_PATH   Override path to liblota_wine_hook.so
#   LOTA_HOOK_DISABLE    Set to 1 (or true) to disable: the wrapper warns
#                        and execs the command with LD_PRELOAD untouched
#   LOTA_HOOK_LOG_LEVEL  debug | info | warn | error | silent
#   LOTA_HOOK_TOKEN_DIR  Custom output directory for status files
#   LOTA_HOOK_REFRESH_SEC  Token refresh interval (default: 60)
#
# Copyright (C) 2026 Szymon Wilczek

set -euo pipefail

# Escape hatch when the preload itself breaks the launch. Checked here,
# not only in the library: by then it is already mapped into the game.
case "${LOTA_HOOK_DISABLE:-}" in
    1 | true)
	echo "lota-proton-hook: LOTA_HOOK_DISABLE set, skipping LOTA integration" >&2
	exec "$@"
	;;
esac

LOTA_HOOK_LIB="${LOTA_HOOK_LIB_PATH:-}"

# also the soname: the bare .so is a -devel symlink
if [[ -z "$LOTA_HOOK_LIB" ]]; then
    for dir in /usr/lib64 /usr/lib /usr/local/lib64 /usr/local/lib; do
        for candidate in \
            "$dir/liblota_wine_hook.so" \
                "$dir"/liblota_wine_hook.so.[0-9]*; do
            if [[ -f "$candidate" ]]; then
                LOTA_HOOK_LIB="$candidate"
                break 2
            fi
        done
    done
fi

if [[ -z "$LOTA_HOOK_LIB" || ! -f "$LOTA_HOOK_LIB" ]]; then
    echo "lota-proton-hook: hook library not found" >&2
    echo "lota-proton-hook: continuing without LOTA integration" >&2
    exec "$@"
fi

if [[ -n "${LD_PRELOAD:-}" ]]; then
    export LD_PRELOAD="${LOTA_HOOK_LIB}:${LD_PRELOAD}"
else
    export LD_PRELOAD="${LOTA_HOOK_LIB}"
fi

# pressure-vessel binds only paths in PRESSURE_VESSEL_FILESYSTEMS_RW.
# Outside a container the variable is ignored.

# share_dir: append $1 unless it is already a whole element
share_dir() {
    local want="$1" entry

    local IFS=:
    for entry in ${PRESSURE_VESSEL_FILESYSTEMS_RW:-}; do
        [[ "$entry" == "$want" ]] && return 0
    done
    unset IFS

    if [[ -n "${PRESSURE_VESSEL_FILESYSTEMS_RW:-}" ]]; then
        PRESSURE_VESSEL_FILESYSTEMS_RW="${PRESSURE_VESSEL_FILESYSTEMS_RW}:${want}"
    else
        PRESSURE_VESSEL_FILESYSTEMS_RW="${want}"
    fi
}

# same order as token_dir_candidate() in src/sdk/lota_wine_hook.c
if [[ -n "${LOTA_HOOK_TOKEN_DIR:-}" ]]; then
    lota_token_dir="$LOTA_HOOK_TOKEN_DIR"
elif [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
    lota_token_dir="${XDG_RUNTIME_DIR}/lota-hook"
else
    lota_token_dir="/tmp/lota-$(id -u)"
fi

# must exist on the host to be bound; on failure the library reports it
(umask 0077 && mkdir -p "$lota_token_dir") 2>/dev/null || true
share_dir "$lota_token_dir"

# agent-owned; share only if present, a missing path fails the container
lota_socket="${LOTA_HOOK_SOCKET:-${XDG_RUNTIME_DIR:+${XDG_RUNTIME_DIR}/lota/lota.sock}}"
if [[ -n "$lota_socket" ]]; then
    lota_socket_dir=$(dirname -- "$lota_socket")
    if [[ -d "$lota_socket_dir" ]]; then
        share_dir "$lota_socket_dir"
    fi
fi

export PRESSURE_VESSEL_FILESYSTEMS_RW

exec "$@"
