#!/bin/bash
# SPDX-License-Identifier: MIT
#
# lota-proton-hook -- Launch wrapper for Steam/Proton with LOTA integration
#
# Sets LD_PRELOAD so that the LOTA Wine hook library is loaded into
# the Wine/Proton process, transparently bridging attestation into
# the Windows game, and shares the agent's socket directory and the hook's
# token directory through PRESSURE_VESSEL_FILESYSTEMS_RW.
#
# Usage:
#   As Steam launch option:
#     lota-proton-hook %command%
#
#   Direct:
#     lota-proton-hook wine game.exe
#     lota-proton-hook proton run game.exe
#
# Environment:
#   LOTA_HOOK_LIB_PATH   Override path to liblota_wine_hook.so
#   LOTA_HOOK_LIB_ROOTS  Colon-separated prefixes holding lib64/ and lib/
#                        (default /usr:/usr/local)
#   LOTA_HOOK_DISABLE    Set to 1 (or true) to disable: the wrapper warns
#                        and execs the command with LD_PRELOAD untouched
#   LOTA_HOOK_ACTIVATE_PATH  Exe prefixes to hook; kept when set, else
#                        the directories Steam names for the launch
#   LOTA_HOOK_ACTIVATE_PROGRAM  Title dir as Wine sees it; kept when set,
#                        else the one Steam installed the title in
#   LOTA_HOOK_LOG_LEVEL  debug | info | warn | error | silent
#   LOTA_HOOK_TOKEN_DIR  Custom output directory for status files
#   LOTA_HOOK_REFRESH_SEC  Token refresh interval (default: 60)
#
# Copyright (C) 2026 Szymon Wilczek

set -euo pipefail

# Escape hatch when the preload itself breaks the launch. Checked here,
# not only in the library: by then it is already mapped into the game.
case "${LOTA_HOOK_DISABLE:-}" in
    1 | true)
	echo "lota-proton-hook: LOTA_HOOK_DISABLE set, skipping LOTA integration" >&2
	exec "$@"
	;;
esac

LOTA_HOOK_LIB="${LOTA_HOOK_LIB_PATH:-}"

# packaged and source-install prefixes; tests override them
IFS=: read -r -a lota_hook_roots <<<"${LOTA_HOOK_LIB_ROOTS:-/usr:/usr/local}"

# the soname too: the bare .so is a -devel symlink;
# an unmatched glob fails the caller's -f
hook_candidates() {
    lota_hook_cands=(
        "$1/liblota_wine_hook.so"
        "$1"/liblota_wine_hook.so.[0-9]*
    )
}

# <root>/$LIB/<name> when lib64/ and lib/ carry one name; else hook_single()
hook_pair() {
    local root candidate name

    for root in "${lota_hook_roots[@]}"; do
        hook_candidates "$root/lib64"
        for candidate in "${lota_hook_cands[@]}"; do
            [[ -f "$candidate" ]] || continue
            name=${candidate##*/}
            [[ -f "$root/lib/$name" ]] || continue
            printf '%s/$LIB/%s\n' "$root" "$name"
            return 0
        done
    done
    return 1
}

hook_single() {
    local root dir candidate

    for root in "${lota_hook_roots[@]}"; do
        for dir in "$root/lib64" "$root/lib"; do
            hook_candidates "$dir"
            for candidate in "${lota_hook_cands[@]}"; do
                if [[ -f "$candidate" ]]; then
                    printf '%s\n' "$candidate"
                    return 0
                fi
            done
        done
    done
    return 1
}

if [[ -z "$LOTA_HOOK_LIB" ]]; then
    LOTA_HOOK_LIB=$(hook_pair || hook_single || true)
fi

# a $LIB path cannot be stat'ed; hook_pair() checked both halves
if [[ -z "$LOTA_HOOK_LIB" ||
	  ( "$LOTA_HOOK_LIB" != *'$LIB'* && ! -f "$LOTA_HOOK_LIB" ) ]]; then
    echo "lota-proton-hook: hook library not found" >&2
    echo "lota-proton-hook: continuing without LOTA integration" >&2
    exec "$@"
fi

if [[ -n "${LD_PRELOAD:-}" ]]; then
    export LD_PRELOAD="${LOTA_HOOK_LIB}:${LD_PRELOAD}"
else
    export LD_PRELOAD="${LOTA_HOOK_LIB}"
fi

# LD_PRELOAD also reaches Steam's helpers, outside the FHS skip list;
# the reaper outlives the title and would keep the 32-bit libc write-pinned.
# Pin the hook to the title and its compatibility tools, as Steam names them.
# A preset pin wins; no install path, no pin.
if [[ -z "${LOTA_HOOK_ACTIVATE_PATH:-}" &&
	  -n "${STEAM_COMPAT_INSTALL_PATH:-}" ]]; then
    # trailing slash: a prefix must not match a sibling directory
    lota_hook_pin="${STEAM_COMPAT_INSTALL_PATH%/}/"

    # colon list in, comma list out; an empty element matches everything
    IFS=: read -r -a lota_hook_tools <<<"${STEAM_COMPAT_TOOL_PATHS:-}"
    for lota_hook_tool in "${lota_hook_tools[@]}"; do
        [[ -n "$lota_hook_tool" ]] || continue
        lota_hook_pin="${lota_hook_pin},${lota_hook_tool%/}/"
    done

    export LOTA_HOOK_ACTIVATE_PATH="$lota_hook_pin"
fi

# Every process of a Proton prefix is the pinned Wine loader; the title is
# told apart by its Windows program. A Steam library is a drive of its own,
# so the path starts at the library root; outside one it is the host path.
# A set value wins.
if [[ -z "${LOTA_HOOK_ACTIVATE_PROGRAM:-}" &&
	  -n "${STEAM_COMPAT_INSTALL_PATH:-}" ]]; then
    lota_hook_title="${STEAM_COMPAT_INSTALL_PATH%/}/"
    if [[ "$lota_hook_title" == */steamapps/common/* ]]; then
        lota_hook_title="steamapps/common/${lota_hook_title##*/steamapps/common/}"
    fi
    export LOTA_HOOK_ACTIVATE_PROGRAM="$lota_hook_title"
fi

# pressure-vessel binds only paths in PRESSURE_VESSEL_FILESYSTEMS_RW.
# Outside a container the variable is ignored.

# share_dir: append $1 unless it is already a whole element
share_dir() {
    local want="$1" entry

    local IFS=:
    for entry in ${PRESSURE_VESSEL_FILESYSTEMS_RW:-}; do
        [[ "$entry" == "$want" ]] && return 0
    done
    unset IFS

    if [[ -n "${PRESSURE_VESSEL_FILESYSTEMS_RW:-}" ]]; then
        PRESSURE_VESSEL_FILESYSTEMS_RW="${PRESSURE_VESSEL_FILESYSTEMS_RW}:${want}"
    else
        PRESSURE_VESSEL_FILESYSTEMS_RW="${want}"
    fi
}

# same order as token_dir_candidate() in src/sdk/lota_wine_hook.c
if [[ -n "${LOTA_HOOK_TOKEN_DIR:-}" ]]; then
    lota_token_dir="$LOTA_HOOK_TOKEN_DIR"
elif [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
    lota_token_dir="${XDG_RUNTIME_DIR}/lota-hook"
else
    lota_token_dir="/tmp/lota-$(id -u)"
fi

# must exist on the host to be bound; on failure the library reports it
(umask 0077 && mkdir -p "$lota_token_dir") 2>/dev/null || true
share_dir "$lota_token_dir"

# agent-owned; share only if present, a missing path fails the container
lota_socket="${LOTA_HOOK_SOCKET:-${XDG_RUNTIME_DIR:+${XDG_RUNTIME_DIR}/lota/lota.sock}}"
if [[ -n "$lota_socket" ]]; then
    lota_socket_dir=$(dirname -- "$lota_socket")
    if [[ -d "$lota_socket_dir" ]]; then
        share_dir "$lota_socket_dir"
    fi
fi

export PRESSURE_VESSEL_FILESYSTEMS_RW

exec "$@"
