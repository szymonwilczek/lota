policy_module(lota, 1.0.0)

## <desc>
## <p>Allow network access for remote attestation.</p>
## </desc>
gen_tunable(lota_network_attest, true)

## <desc>
## <p>Allow BPF program loading.</p>
## </desc>
gen_tunable(lota_bpf_load, true)

type lota_agent_t;
type lota_agent_exec_t;
init_daemon_domain(lota_agent_t, lota_agent_exec_t)

# lota-agent.service sets NoNewPrivileges=yes, under which entering
# lota_agent_t from init_t needs nnp_transition; nosuid_transition is
# needed when the binary is on a nosuid mount.
allow init_t lota_agent_t:process2 { nnp_transition nosuid_transition };

# Labels /var/lib/lota and /run/lota; as a pid_file type it lets systemd
# manage /run/lota, the RuntimeDirectory of lota-agent.socket.
type lota_var_t;
files_pid_file(lota_var_t)

type lota_etc_t;
files_config_file(lota_etc_t)

type lota_bpf_t;
files_type(lota_bpf_t)

# A loadable module cannot carry portcon, so no port is labelled here:
# lota-install labels the endpoints it was given, any other is the
# operator's:
#
#   semanage port -a -t lota_port_t -p tcp <port>
type lota_port_t;
corenet_port(lota_port_t)

# configs/udev/99-lota-tpm.rules relabels /dev/tpm[0-9]* and
# /dev/tpmrm[0-9]* from tpm_device_t at device-add time. The label does
# not fence root, and a module cannot revoke base-policy grants.
type lota_tpm_device_t;
dev_node(lota_tpm_device_t)

# sys_ptrace reads another process's /proc maps and map_files for the
# runtime image measurement; the agent's LSM hook exempts it for read
# access only.
allow lota_agent_t self:capability { dac_override dac_read_search sys_admin sys_ptrace chown };

# A title in a user namespace (Proton) is checked in that namespace,
# so measuring and terminating it go through cap_userns.
allow lota_agent_t self:cap_userns { kill sys_ptrace };

allow lota_agent_t self:capability2 { bpf perfmon };
allow lota_agent_t self:process { signal signull };
allow lota_agent_t self:fifo_file rw_fifo_file_perms;
allow lota_agent_t self:unix_stream_socket create_stream_socket_perms;
allow lota_agent_t self:unix_dgram_socket create_socket_perms;

allow lota_agent_t lota_etc_t:dir list_dir_perms;
allow lota_agent_t lota_etc_t:file read_file_perms;

allow lota_agent_t lota_var_t:dir manage_dir_perms;
allow lota_agent_t lota_var_t:file manage_file_perms;

# /run/lota/lota.sock: the daemon binds it when not socket-activated and
# again once the file is replaced; one-shots such as --shutdown connect
# to it.
allow lota_agent_t lota_var_t:sock_file manage_sock_file_perms;
allow lota_agent_t self:unix_stream_socket connectto;

# A link planted at /run/lota/.bench.tmp or bench.json is removed or
# renamed over, never followed; that is all the daemon may do to one.
allow lota_agent_t lota_var_t:lnk_file unlink;

allow lota_agent_t lota_bpf_t:dir list_dir_perms;
allow lota_agent_t lota_bpf_t:file { read_file_perms execute map };

# Per-user container socket, /run/user/<uid>/lota/lota.sock
userdom_manage_tmp_dirs(lota_agent_t)
userdom_manage_tmp_sockets(lota_agent_t)
userdom_watch_tmp_dirs(lota_agent_t)

allow lota_agent_t lota_tpm_device_t:chr_file rw_chr_file_perms;

# the node keeps the stock tpm_device_t until udev relabels it
dev_rw_tpm(lota_agent_t)

dev_read_urand(lota_agent_t)
dev_read_rand(lota_agent_t)

kernel_read_system_state(lota_agent_t)

tunable_policy(`lota_bpf_load',`
        allow lota_agent_t self:bpf { map_create map_read map_write prog_load prog_run };
')

domain_read_all_domains_state(lota_agent_t)
kernel_read_proc_symlinks(lota_agent_t)

# Runtime image measurement opens each executable mapping of a protected
# process through /proc/<pid>/map_files and measures it with
# FS_IOC_MEASURE_VERITY; what the title maps decides the type. A library
# or other mapping of a security file (shadow, keytabs, home records) or
# of System.map stays unmeasured and clears IMAGE_FULLY_MEASURED.
# A title whose executable is one cannot be measured: asking for a token,
# it is refused.
gen_require(`
	attribute file_type, security_file_type;
	type system_map_t;
')
allow lota_agent_t file_type:dir list_dir_perms;
allow lota_agent_t { file_type -security_file_type -system_map_t }:file
	read_file_perms;

# fstatfs() of each mapping feeds the road for a title without fs-verity
fs_getattr_all_fs(lota_agent_t)

# The agent relays SIGTERM or SIGKILL to a protected process for its
# owner or root (terminate_policy.h), across uids and whatever its domain.
allow lota_agent_t self:capability kill;
allow lota_agent_t domain:process { signal sigkill };

files_read_boot_files(lota_agent_t)
files_read_boot_symlinks(lota_agent_t)

dev_read_sysfs(lota_agent_t)
# libbpf maps /sys/kernel/btf/vmlinux for CO-RE relocations
dev_map_sysfs(lota_agent_t)

fs_read_efivarfs_files(lota_agent_t)

selinux_get_fs_mount(lota_agent_t)

kernel_read_kernel_sysctls(lota_agent_t)

# Under systemd, or once detached from a terminal, the agent logs via
# sd_journal_send().
logging_send_syslog_msg(lota_agent_t)
logging_send_audit_msgs(lota_agent_t)

dbus_system_bus_client(lota_agent_t)

# owning org.lota.Agent1 needs acquire_svc, which
# dbus_system_bus_client() does not grant
gen_require(`
	class dbus acquire_svc;
')
allow lota_agent_t system_dbusd_t:dbus acquire_svc;

# pidfs_t is defined only by newer policies
optional_policy(`
	gen_require(`
		type pidfs_t;
	')
	allow lota_agent_t pidfs_t:filesystem getattr;
')

# Type=notify: sd_notify(READY=1) sends a datagram to init
init_dgram_send(lota_agent_t)
init_use_notify(lota_agent_t)
init_read_pid_files(lota_agent_t)

sysnet_dns_name_resolve(lota_agent_t)

tunable_policy(`lota_network_attest',`
        allow lota_agent_t lota_port_t:tcp_socket name_connect;
        corenet_tcp_connect_http_port(lota_agent_t)
        allow lota_agent_t self:tcp_socket create_stream_socket_perms;
        allow lota_agent_t self:udp_socket create_socket_perms;
        allow lota_agent_t self:netlink_route_socket { create bind getattr nlmsg_read };
')

files_read_etc_files(lota_agent_t)
miscfiles_read_localization(lota_agent_t)
init_use_fds(lota_agent_t)
init_read_state(lota_agent_t)
files_pid_filetrans(lota_agent_t, lota_var_t, file, "lota-agent.pid")
