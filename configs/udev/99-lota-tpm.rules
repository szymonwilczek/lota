# SPDX-License-Identifier: MIT
#
# Restrict /dev/tpm* and /dev/tpmrm* to the agent, so that no other process
# sends the TPM commands, a PCR 14 extend among them.
#
# Each node is root:root 0600 and labelled lota_tpm_device_t. Only
# lota_agent_t is granted it by the LOTA SELinux module; a confined domain
# that the base policy gives tpm_device_t loses the TPM, while an
# unconfined domain keeps it through device_node. Without SELinux in
# enforcing mode only the root-only mode applies.
#
# The packages install this file. After a manual install:
#   udevadm control --reload-rules
#   udevadm trigger --action=add --subsystem-match=tpm --subsystem-match=tpmrm
# SECLABEL applies only on add, and /dev/tpmrm0 is in subsystem tpmrm.

KERNEL=="tpm[0-9]*",   MODE="0600", OWNER="root", GROUP="root", SECLABEL{selinux}="system_u:object_r:lota_tpm_device_t:s0"
KERNEL=="tpmrm[0-9]*", MODE="0600", OWNER="root", GROUP="root", SECLABEL{selinux}="system_u:object_r:lota_tpm_device_t:s0"
