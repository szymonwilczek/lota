# /etc/lota/lota.conf -- LOTA Agent configuration
#
# One key = value per line. A line whose first non-blank character is '#' is a
# comment; a '#' after a value is part of the value. A key with more than one
# word may be written with hyphens instead (ca-cert for ca_cert).
#
# The file must be a regular file that is neither group- nor world-writable,
# owned by root (for an agent run as another user, by that user or root).
# An unknown key or a value the key's parser rejects makes the agent refuse
# the whole file.
#
# A command-line flag replaces the value of the key it names here, except
# --allow-verity, --trust-lib and --protect-pid, which add to the entries
# read from this file.
#
# A [profile "name"] header opens a publisher profile, and every key after it
# belongs to that profile, so the top-level keys go above the first profile.
#
# To print the configuration as the agent reads it:
#   lota-agent --dump-config
#   lota-agent --config /path/to/file --dump-config

# ---- Verifier connection ------------------------------------------------

# The single verifier --attest reports to when no [profile] is configured.
# There is no default.
# server = verifier.example.com

port = 8443

# CA certificate the verifier's TLS certificate is checked against
# (default: the system CA store)
# ca_cert = /etc/lota/ca.pem

# Pin the verifier's certificate by SHA-256 fingerprint (64 hex characters;
# colons and spaces are allowed). With [profile] entries configured, the pin
# goes inside each profile instead, and a pin here is refused.
# pin_sha256 = 4fd24ead1c6c1c0d2e5f0a9b8c7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d

# ---- BPF / enforcement --------------------------------------------------

bpf_path = /usr/lib/lota/lota_lsm.bpf.o

# Enforcement mode: monitor or enforce (default: enforce). A --mode below the
# mode set here is refused without --insecure-allow-mode-downgrade.
# mode = enforce

# Strict policy flags, all off by default. They act in enforce mode only;
# in monitor mode `lota-agent --dump-config` and the startup log list them as
# inert.
#
# block_ptrace refuses every ptrace attach. Reading another process's /proc
# is not an attach and stays the kernel's decision. In either mode and with
# or without the flag, the agent and each protected process refuse both to
# anything outside their own instance.
#
# strict_exec and strict_modules need at least one allow_verity entry below;
# with neither the agent refuses to start.
#
# strict_modules lets a module or firmware file load only when its fs-verity
# digest is in the allow_verity list, and refuses a module handed over from
# memory. Where modprobe passes the compressed .ko.xz or .ko.zst file to the
# kernel, that compressed file is the one that needs fs-verity and an entry.
# strict_mmap = true
# strict_exec = true
# block_ptrace = true
# strict_modules = true
# block_anon_exec = true

# bench: write the agent's own cost, and the protected set's as one sum, to
# /run/lota/bench.json once a second, mode 0640, group lota (root only when
# the group is missing). The status word and the report flag it as on.
# Read at startup only.
# bench = true

# allow_verity: a file with fs-verity enabled, by absolute path. The agent
# measures its fs-verity digest at startup and allows that digest; a path it
# cannot measure makes it refuse to start. One entry per line, up to 256.
#
# allow_verity = /usr/bin/my_verified_binary
# allow_verity = /usr/lib/my_verified_module.ko

# ---- Attestation ---------------------------------------------------------

# Seconds between attestation rounds of `lota-agent --attest`, which the
# packaged lota-attest.service runs: 0, or 30 to 240.
#
# 0 is no cadence chosen. With [profile] entries the loop then attests every
# 240 s; with no profile but a `server`, --attest attests once and exits; with
# neither, the loop runs with no target until a reload names a publisher.
attest_interval = 240

# ---- Sealed AIK auth ------------------------------------------------------
# Keep the AIK userAuth sealed to PCRs 0-7, so it unseals only while the
# firmware, its configuration, the boot loader and Secure Boot state measure
# as they did when it was sealed. PCR 14 is not in the set, so an agent
# upgrade keeps it. Both default to false: the auth is then kept in plain
# text beside the key.
#
#   seal_aik_auth         also write a sealed copy and prefer it on load;
#                         use the plain-text copy when the sealed one is
#                         missing or does not unseal.
#   seal_aik_auth_strict  keep only the sealed copy and never fall back.
#                         When the key is in the TPM but its sealed copy is
#                         missing or no longer unseals while either copy is
#                         on disk, as after turning this on for a key kept
#                         in plain text, the agent refuses to use or replace
#                         the key; the operator restores the record or
#                         replaces the key with --forget-publisher,
#                         --allow-publisher and --enroll. With neither copy,
#                         or no key in the TPM, the agent provisions a new
#                         key.
# seal_aik_auth = false
# seal_aik_auth_strict = false

# ---- Seal storage primary -------------------------------------------------
# Every seal and unseal (--seal, --unseal, the sealed AIK auth) derives its
# storage primary with CreatePrimary, using no persistent handle. After
#   lota-agent --seal-persist-primary
# set this to true to reuse the persisted primary instead; without one the
# agent still derives it. Both primaries are the same key, so sealed blobs
# stay valid either way. Remove it with
#   lota-agent --seal-evict-primary
# seal_persistent_primary = false

# Absolute path to the booted kernel image, for a distribution without
# /boot/vmlinuz-<release>. `--test-tpm` hashes it and attestation reports
# carry its path. `--export-policy` does not use it: the kernel digest there is
# the boot loader's measurement of the image it loaded.
# kernel_path = /efi/EFI/Linux/linux.efi

# ---- Daemon --------------------------------------------------------------

# Fork to the background; the packaged unit runs the agent in the foreground
daemon = false

pid_file = /run/lota/lota-agent.pid

# ---- Policy signing ------------------------------------------------------

# Ed25519 public key the enforcement object's signature is checked against.
# The agent takes the first readable one of this path, /etc/lota/policy.pub
# and /usr/lib/lota/enforcement.pub, so an unreadable path here is skipped.
# policy_pubkey = /etc/lota/policy.pub

# ---- Logging -------------------------------------------------------------

# Log level: debug, info, warn or error.
log_level = info

# ---- Trusted libraries ---------------------------------------------------
# A trusted library passes the strict_mmap check on executable mappings. Each
# entry is an absolute path to a regular file with no symlink along it; one
# that does not resolve makes the agent refuse to start. One per line, up to
# 64.
# trust_lib = /usr/lib64/libc.so.6

# ---- Protected PIDs ------------------------------------------------------
# One protect_pid entry per line, up to 1024; a reload reads them again.
# protect_pid = 1234
# protect_pid = 5678

# ---- Publisher profiles (must stay last) ---------------------------------
# One machine, several publishers, up to 8. Each profile names the attestation
# CA it enrolls against (ca, ca_port), that CA's trust anchor (ca_cert) and the
# verifier it reports to (verifier, verifier_port). A profile gives its
# publisher no say over this host's enforcement.
#
# The section name is a label for the operator. A profile is identified by
# the SHA-256 of its ca_cert's SubjectPublicKeyInfo, so ca_cert is required,
# and moving the CA to a new address keeps the profile. ca_cert must be
# readable by lota-attest.service, as the top-level ca_cert is.
#
# ca_port defaults to 8444 and verifier_port to 8443. interval defaults to
# attest_interval above (240 when that is 0) and takes the same range.
#
# reporting = session (the default) sends that publisher reports only while
# one of their titles runs. reporting = continuous reports on every round,
# as an operator-owned fleet wants. Enforcement and the PCR 14 boot
# commitment stay on either way.
#
# The agent enrolls a profile itself: when the loop first reaches it, and at
# once when a title asks for that publisher.
#
# The profiles are the attestation loop's targets: each is reported to on its
# own cadence, signed with that publisher's own AIK, and an unreachable
# verifier backs off only its own reporting. With profiles configured,
# --attest refuses --server and --pin-sha256, and a top-level pin_sha256 is
# refused: each profile carries its own pin.
#
# verifier = none is for a publisher who runs no verifier and checks the
# tokens their titles fetch in their own backend. Nothing is reported to
# them, but the profile still enrolls, holds its own AIK and renews that key's
# certificate, which their backend chains a token to. The verifier key is
# required, so a missing one is refused rather than read as none, and a
# verifier_port is refused alongside none.
#
# [profile "publisher-a"]
# ca = ca.publisher-a.example
# ca_cert = /etc/lota/publisher-a.pem
# verifier = verifier.publisher-a.example
#
# [profile "publisher-b"]
# reporting = continuous
# ca = ca.publisher-b.example
# ca_port = 9444
# ca_cert = /etc/lota/publisher-b.pem
# verifier = verifier.publisher-b.example
# verifier_port = 9443
# pin_sha256 = 0123456789abcdef0123456789abcdeffedcba9876543210fedcba9876543210
# interval = 120
#
# [profile "publisher-c"]
# ca = ca.publisher-c.example
# ca_cert = /etc/lota/publisher-c.pem
# verifier = none
