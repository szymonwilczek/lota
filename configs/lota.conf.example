# /etc/lota/lota.conf -- LOTA Agent configuration
#
# Line-oriented key = value format.
# Lines starting with '#' are comments. Empty lines are ignored.
# Keys accept both underscore and hyphen forms (e.g: ca_cert, ca-cert).
# CLI flags override any value set here.
#
# [profile "name"] header opens a publisher profile and every key after it belongs
# to that profile, so the top-level keys go above the first profile and the profiles
# go last.
# See the end of this file.
#
# To dump the effective configuration after loading this file:
#   lota-agent --dump-config
#   lota-agent --config /path/to/file --dump-config

# ---- Verifier connection ------------------------------------------------

# Verifier server address
server = localhost

# Verifier server port
port = 8443

# CA certificate for TLS verification (default: system CA store)
# ca_cert = /etc/lota/ca.pem

# Pin verifier certificate by SHA-256 fingerprint (64 hex chars)
# pin_sha256 = aabbccdd...

# ---- BPF / enforcement --------------------------------------------------

# Path to compiled BPF object file
bpf_path = /usr/lib/lota/lota_lsm.bpf.o

# Enforcement mode: monitor, enforce, maintenance
# Default is enforce.
# mode = enforce

# Strict policy flags.
#   strict_mmap, block_ptrace, block_anon_exec   -- on by default.
#   strict_exec, strict_modules                  -- off by default.
#
# strict_exec and strict_modules require at least one allow_verity entry
# below. Enabling either without populating allow_verity makes the agent
# refuse to start. A fresh install has no fs-verity allowlist by design,
# so both flags default to off; the operator opts in once the
# allow_verity list is provisioned.
# strict_mmap = true
# strict_exec = true
# block_ptrace = true
# strict_modules = true
# block_anon_exec = true

# allow_verity: allow fs-verity protected files by digest.
#
# Each entry must be an absolute path and must refer to a file with fs-verity
# enabled. The agent measures the fs-verity digest at startup and provisions it
# into the BPF allowlist.
#
# allow_verity = /usr/bin/my_verified_binary
# allow_verity = /usr/lib/my_verified_module.ko

# ---- Attestation ---------------------------------------------------------

# Continuous attestation interval in seconds (0 = one-shot when --attest)
#
# Packaged lota-attest.service runs `lota-agent --attest` fire-and-forget
# and reads this value: non-zero interval keeps the loop running (and renews
# the AIK certificate before it expires), while 0 attests once and exits.
#
# Set `server`, `port` and `ca_cert` above to the verifier the loop should reach.
# Service stays inactive until the first `lota-agent --enroll` creates publisher
# profile under /var/lib/lota/profiles/
attest_interval = 300

# AIK key lifetime in seconds before rotation (0 = default 30 days)
aik_ttl = 0

# ---- Sealed AIK auth (at-rest hardening) ---------------------------------
# Keep a copy of the AIK userAuth sealed to the boot/PCR state (PCRs 0-7 +
# PCR14) so it is only usable when the host booted as expected. Both keys
# default to false, which preserves the plaintext-sidecar behaviour exactly.
#
#   seal_aik_auth         also write a sealed copy and prefer it on load;
#                         falls back to the plaintext sidecar if the sealed
#                         copy is missing or the boot state changed.
#   seal_aik_auth_strict  store ONLY the sealed copy (no plaintext on disk)
#                         and never fall back. A firmware/kernel/agent change
#                         then forces AIK re-provisioning instead of exposing
#                         the auth.
# seal_aik_auth = false
# seal_aik_auth_strict = false

# ---- Seal storage primary (performance) ----------------------------------
# By default --seal/--unseal derive their storage primary per operation with
# CreatePrimary: stateless and consuming no persistent slot. A host that
# seals/unseals frequently can persist the primary once with
#   lota-agent --seal-persist-primary
# and set the following to true so the seal path reuses it and skips the
# per-op CreatePrimary. The derived and persisted primaries are identical,
# so existing sealed blobs stay valid either way. Remove it with
#   lota-agent --seal-evict-primary
# seal_persistent_primary = false

# Optional absolute path to currently booted kernel image.
# Use this on distros that do not expose /boot/vmlinuz-<release>.
# kernel_path = /efi/EFI/Linux/linux.efi

# ---- Daemon --------------------------------------------------------------

# Fork to background (not needed under systemd)
daemon = false

# PID file location
pid_file = /run/lota/lota-agent.pid

# ---- Policy signing ------------------------------------------------------

# Ed25519 private key for signing policies
# signing_key = /etc/lota/policy.key

# Ed25519 public key for verifying policy signatures
# policy_pubkey = /etc/lota/policy.pub

# ---- Logging -------------------------------------------------------------

# Log level: debug, info, warn, error
log_level = info

# ---- Trusted libraries ---------------------------------------------------
# Multiple trust_lib entries are allowed (one per line).
# trust_lib = /usr/lib64/libc.so.6
# trust_lib = /usr/lib64/libssl.so.3

# ---- Protected PIDs ------------------------------------------------------
# Multiple protect_pid entries are allowed (one per line).
# protect_pid = 1234
# protect_pid = 5678

# ---- Publisher profiles (must stay last) ---------------------------------
# One machine, several publishers.
# Each profile names the attestation CA it enrolls against, the trust anchor
# that CA is verified with, and the verifier it reports to.
# The publisher's policy is entirely on their side: profile grants no publisher
# any say over this host's enforcement.
#
# The section name is label for the operator.
# Profile is identified by the SHA-256 of its ca_cert trust anchor's
# SubjectPublicKeyInfo, which is why the anchor is required and why moving CA
# to new address keeps the profile.
#
# ca_cert must be readable by the hardened lota-attest.service, exactly as the
# top-level ca_cert above.
#
# ca_port defaults to 8444 and verifier_port to 8443.
# interval defaults to the attest_interval above; set it only where publisher
# wants different cadence, and keep it inside the range lota-agent --help prints
#
# Every key below a header belongs to that profile, so nothing top-level may
# follow.
# `lota-agent --dump-config` prints profiles last for the same reason.
#
# Profile whose CA this host has never enrolled with is enrolled by the agent itself
# -- when the loop first reaches it, and immediately when a title selects that
# publisher. That is why `ca` and `ca_cert` belong in the profile:
# on player's machine there is no install-time step at which the publisher is
# even known yet.
#
# Profile list is the attestation loop's target list:
# the agent reports to every profile's verifier on that profile's cadence,
# signing each report with that publisher's own AIK, and one unreachable verifier
# backs off only its own reporting.
# Because the list replaces the single verifier above, --server and --pin-sha256
# are refused while profiles are configured.
#
# [profile "publisher-a"]
# ca = ca.publisher-a.example
# ca_cert = /etc/lota/publisher-a.pem
# verifier = verifier.publisher-a.example
#
# [profile "publisher-b"]
# ca = ca.publisher-b.example
# ca_port = 9444
# ca_cert = /etc/lota/publisher-b.pem
# verifier = verifier.publisher-b.example
# verifier_port = 9443
# interval = 120
