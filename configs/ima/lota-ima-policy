#
# LOTA IMA developer baseline, not a production appraisal policy.
# scripts/lota-dev-bringup.sh loads it only in ima_appraise=fix, log or off,
# and only when the loaded policy is readable and has no appraise rule on
# BPRM_CHECK or with no func=; a failed write only warns. Production
# signatures and rules come from the distribution or the operator;
# LOTA signs no executable.
#
# The appraise rules reach every exec and every PROT_EXEC mmap outside the
# filesystems listed in dont_appraise (pseudo filesystems and tmpfs),
# and accept only a valid security.ima signature. A kernel built with
# CONFIG_IMA_APPRAISE enforces appraisal by default, and under Secure Boot
# whatever ima_appraise= says; without Secure Boot only ima_appraise=fix,
# log or off lowers it. Loading this file on a host without IMA signatures
# refuses every such exec unless the kernel takes one of those.
#
# The agent's kernel appraisal check passes only when the loaded policy has
# an appraise rule on BPRM_CHECK or with no func=; a kernel built without
# CONFIG_IMA_READ_POLICY does not publish the policy, and the agent then
# reports the scope as unknown.

dont_appraise fsmagic=0x9fa0
dont_appraise fsmagic=0x62656572
dont_appraise fsmagic=0x64626720
dont_appraise fsmagic=0x01021994
dont_appraise fsmagic=0x73636673
dont_appraise fsmagic=0xf97cff8c
dont_appraise fsmagic=0x43415d53
dont_appraise fsmagic=0x6e736673
dont_appraise fsmagic=0xde5e81e4
dont_appraise fsmagic=0x9fa2
measure func=BPRM_CHECK
measure func=MMAP_CHECK mask=MAY_EXEC
appraise func=BPRM_CHECK appraise_type=imasig
appraise func=MMAP_CHECK mask=MAY_EXEC appraise_type=imasig
