{
  "target": "linux/amd64",
  "name": "lota-fuzzer",
  "http": "0.0.0.0:56741",
  "workdir": "./workdir",
  "kernel_obj": "/path/to/linux-build-dir",
  "image": "/path/to/trixie.img",
  "sshkey": "/path/to/trixie.id_rsa",
  "syzkaller": "/path/to/syzkaller/repo",

  "type": "qemu",
  "sandbox": "none",
  "procs": 6,
  "cover": true,
  "reproduce": true,

  "vm": {
    "count": 4,
    "kernel": "/path/to/linux/arch/x86/boot/bzImage",
    "cpu": 2,
    "mem": 3072,
    "cmdline": "root=/dev/sda console=ttyS0 earlyprintk=serial net.ifnames=0 biosdevname=0 oops=panic panic=1 panic_on_warn=1 panic_on_oops=1 slab_nomerge pti=on mitigations=auto,nosmt lsm=lockdown,yama,integrity,apparmor,bpf"
  },

  "enable_syscalls": [
    "socket$unix",
    "connect",
    "sendto",
    "recvfrom",
    "read",
    "write",
    "shutdown",
    "close",

    "socket$lota_unix",
    "connect$lota",
    "write$lota_ping",
    "write$lota_status",
    "write$lota_token",
    "write$lota_subscribe",
    "write$lota_fuzz_small",
    "write$lota_fuzz_big",
    "write$lota_raw",
    "sendto$lota_raw",
    "read$lota",
    "recvfrom$lota",
    "shutdown$lota",
    "close$lota",

    "bpf$BPF_BTF_GET_NEXT_ID",
    "bpf$BPF_BTF_GET_FD_BY_ID",
    "bpf$TOKEN_CREATE",
    "bpf$MAP_CREATE",
    "bpf$MAP_LOOKUP_ELEM",
    "bpf$MAP_DELETE_ELEM",
    "bpf$OBJ_PIN_MAP",
    "bpf$OBJ_GET_MAP",

    "ptrace$cont",
    "ptrace$setopts",
    "ptrace$poke",
    "ptrace$peek",
    "kill",
    "tgkill",
    "pidfd_open",
    "pidfd_send_signal",

    "kexec_load",
    "init_module",
    "syz_create_resource$binfmt",
    "openat$binfmt",
    "finit_module",
    "delete_module",

    "setuid",
    "setreuid",
    "setresuid",

    "mount",
    "move_mount",
    "open_tree",
    "fsopen",
    "fsconfig$FSCONFIG_CMD_CREATE",
    "fsmount",

    "memfd_create",
    "mmap",
    "mprotect",
    "execve",
    "execveat",
    "openat",
    "openat$lota_mem",
    "openat$lota_kmem",
    "openat$lota_port",
    "faccessat"
  ],

  "suppressions": [],
  "email_addrs": [
    "swilczek.lx@gmail.com"
  ]
}
