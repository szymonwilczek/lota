# SPDX-License-Identifier: MIT
#
# Drop-in for lota-agent.service: XDG_RUNTIME_DIR=/run/user/<uid> names the
# uid for which the agent watches /run/user and creates <dir>/lota/lota.sock.
# Without it, and without container_listener_uid in /etc/lota/lota.conf,
# no container socket is served. A container_listener_uid entry overrides
# XDG_RUNTIME_DIR and can name more than one uid.
#
# Install it as /etc/systemd/system/lota-agent.service.d/10-xdg-runtime.conf
# with 1000 replaced by the uid, run systemctl daemon-reload, and reboot;
# lota-steam-setup --install-systemd-dropin writes the file for $SUDO_UID.
# Restarting lota-agent.service or lota-agent.socket instead stops the
# agent, which spends this boot's PCR 14 commitment.

[Service]
Environment=XDG_RUNTIME_DIR=/run/user/1000
