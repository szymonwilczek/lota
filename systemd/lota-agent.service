[Unit]
Description=LOTA - Linux Open Trusted Attestation Agent
Documentation=https://github.com/szymonwilczek/lota
# after udev's coldplug trigger, which queues the rule relabelling /dev/tpm*
After=systemd-udevd.service systemd-udev-trigger.service
After=systemd-tmpfiles-setup.service
After=tpm2-abrmd.service dbus.service
After=network.target local-fs.target
Before=multi-user.target getty.target
Wants=tpm2-abrmd.service
Requires=lota-agent.socket

[Service]
Type=notify
NotifyAccess=main
# no --mode: the mode comes from /etc/lota/lota.conf, and a --mode below
# its enforce is refused without --insecure-allow-mode-downgrade
ExecStart=/usr/bin/lota-agent
ExecStop=/usr/bin/lota-agent --shutdown
# above the 60 s --shutdown waits for the daemon to exit (SHUTDOWN_WAIT_MS)
TimeoutStopSec=90s
ExecReload=/bin/kill -HUP $MAINPID
# The lota group comes from sysusers, so /etc/group answers. nss-systemd would
# still walk /run/systemd/userdb, which the policy refuses with one AVC a socket.
Environment=SYSTEMD_BYPASS_USERDB=1
WatchdogSec=60s
Restart=on-failure
RestartSec=5s
# 78: only an operator can clear it; 3: another agent holds the PID file
RestartPreventExitStatus=78 3

User=root
Group=root

# Not -1000: under a memory limit on this unit with nothing left to kill in
# it, a page fault retries in the kernel instead of ending the agent.
OOMScoreAdjust=-900

ProtectSystem=strict
ReadWritePaths=/var/lib/lota /run/lota
ReadOnlyPaths=/etc/lota /usr/lib/lota

# not ProtectHome=yes: that also empties /run/user,
# where the agent creates the per-user container socket
InaccessiblePaths=/home /root

PrivateTmp=yes

DevicePolicy=closed
DeviceAllow=/dev/tpmrm0 rw
DeviceAllow=/dev/tpm0 rw

# CAP_SYS_PTRACE reads other processes' /proc maps and map_files, CAP_KILL
# signals a protected process of another uid, CAP_CHOWN gives the per-user
# container socket its lota group
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_BPF CAP_PERFMON CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_KILL CAP_CHOWN
AmbientCapabilities=CAP_SYS_ADMIN CAP_BPF CAP_PERFMON CAP_SYS_PTRACE

NoNewPrivileges=yes
SystemCallFilter=@system-service @io-event @network-io
SystemCallFilter=bpf perf_event_open

# the agent installs its own seccomp filter
SystemCallFilter=seccomp
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
PrivateUsers=no
RestrictNamespaces=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=no
ProtectControlGroups=yes

# not ProcSubset=pid: the agent reads /proc/cmdline
ProtectProc=invisible
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryDenyWriteExecute=no
LockPersonality=yes
UMask=0077
RestrictRealtime=yes
KeyringMode=private
SupplementaryGroups=
SecureBits=noroot-locked

LimitMEMLOCK=64M
LimitNOFILE=4096

StandardOutput=journal
StandardError=journal
SyslogIdentifier=lota-agent
SyslogFacility=auth

[Install]
WantedBy=multi-user.target
Alias=lota.service
