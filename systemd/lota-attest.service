[Unit]
Description=LOTA continuous remote attestation
Documentation=https://github.com/szymonwilczek/lota
After=lota-agent.service network-online.target
Wants=lota-agent.service network-online.target

[Service]
Type=simple

# no flags: server, port, ca_cert and attest_interval come from
# /etc/lota/lota.conf
ExecStart=/usr/bin/lota-agent --attest

# SIGHUP rebuilds the target list from /etc/lota/lota.conf between rounds
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=30s

# 78: a refused self-measurement that no restart clears this boot
RestartPreventExitStatus=78

# the loop pings the watchdog on its own pace, apart from attest_interval
WatchdogSec=60s
NotifyAccess=main

User=root
Group=root

ProtectSystem=strict
ReadWritePaths=/var/lib/lota /run/lota
ReadOnlyPaths=/etc/lota /usr/lib/lota
ProtectHome=yes
PrivateTmp=yes

DevicePolicy=closed
DeviceAllow=/dev/tpmrm0 rw
DeviceAllow=/dev/tpm0 rw

CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes

SystemCallFilter=@system-service @network-io
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM

RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

PrivateUsers=no
RestrictNamespaces=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProtectClock=yes
ProtectHostname=yes

MemoryDenyWriteExecute=yes
LockPersonality=yes
UMask=0077
RestrictRealtime=yes
KeyringMode=private
SupplementaryGroups=
SecureBits=noroot-locked

LimitMEMLOCK=64M
LimitNOFILE=1024

StandardOutput=journal
StandardError=journal
SyslogIdentifier=lota-attest
SyslogFacility=auth

[Install]
WantedBy=multi-user.target
