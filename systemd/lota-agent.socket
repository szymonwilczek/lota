[Unit]
Description=LOTA Agent IPC Socket
Documentation=https://github.com/szymonwilczek/lota

[Socket]
ListenStream=/run/lota/lota.sock
SocketMode=0660
SocketUser=root
SocketGroup=lota
Backlog=16
DirectoryMode=0750
RuntimeDirectory=lota

# the initramfs writes /run/lota/pcr14_baseline before this unit starts
RuntimeDirectoryPreserve=yes
RemoveOnStop=yes
Service=lota-agent.service

[Install]
WantedBy=sockets.target
