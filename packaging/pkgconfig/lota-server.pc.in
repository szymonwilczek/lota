#
# The prefix is resolved from this file's own location
# so the SDK is consumable from a staged prefix
# (DESTDIR, a container layer, a CI checkout)
# and not only from /usr.
prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib64
includedir=${prefix}/include

Name: lota-server
Description: LOTA server SDK - attestation token verification for a relying party
URL: https://github.com/szymonwilczek/lota
Version: @LOTA_ABI_VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -llotaserver
Requires.private: libcrypto
